{
  "name": "exodus4d/pathfinder_websocket",
  "description": "WebSocket extension for 'Pathfinder'",
  "minimum-stability": "stable",
  "license": "MIT",
  "authors": [
    {
      "name": "Mark Friedrich",
      "email": "pathfinder@exodus4d.de"
    }
  ],
  "autoload": {
    "psr-4": {
      "Exodus4D\\Socket\\": "app/"
    }
  },
  "require": {
    "php-64bit": ">=8.2",
    "ext-json": "*",
    "cboden/ratchet": "^0.4.4",
    "react/promise": "^3.2",
    "react/promise-stream": "^1.7",
    "clue/ndjson-react": "^1.3"
  },
  "suggest": {
    "ext-event": "If installed, 'ExtEventLoop' class will get used as default event loop. Better performance. https://pecl.php.net/package/event"
  },
  "require-dev": {
    "phpstan/phpstan": "^2.3",
    "phpstan/phpstan-deprecation-rules": "^2.0",
    "rector/rector": "^2.7"
  },
  "scripts": {
    "phpstan": "vendor/bin/phpstan analyse --memory-limit=512M",
    "phpstan-baseline": "vendor/bin/phpstan analyse --generate-baseline --memory-limit=512M",
    "rector": "vendor/bin/rector process --dry-run"
  }
}
